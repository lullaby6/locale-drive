---
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";

import Command from "@/components/Command.astro";
import Header from "@/components/Header.astro";
import Icon from "@/components/Icon";
import Screenshots from "@/components/Screenshots";
import type { Shot, ShotImage } from "@/components/Screenshots";

import {
	DESKTOP_REPO_URL,
	GITHUB_URL,
	ISSUES_URL,
	LICENSE_URL,
	NODE_VERSION,
	NPM_URL,
	RELEASES_URL,
	withBase,
} from "@/config";
import { getT } from "@/i18n";
import type { Language } from "@/i18n";
import { fetchLatestRelease } from "@/release";

interface Props {
	language: Language;
}

const { language } = Astro.props;
const t = getT(language);

// Download links from the latest release at build time; the script at the end refreshes them in the
// browser. Until an asset is found, its button opens the latest release page.
const release = await fetchLatestRelease();
const installer = release?.installer ?? null;
const portable = release?.portable ?? null;

// Screenshots taken from the real app, in both languages and themes: <view>-<language>-<theme>.png
const files = import.meta.glob<{ default: ImageMetadata }>("../assets/screenshots/*.png", { eager: true });
const screenshot = (view: string, theme: "light" | "dark") => files[`../assets/screenshots/${view}-${language}-${theme}.png`].default;

async function optimize(source: ImageMetadata, phone: boolean): Promise<ShotImage> {
	const [small, full] = await Promise.all([
		getImage({ src: source, width: phone ? 640 : 1600, format: "webp", quality: 85 }),
		getImage({ src: source, width: phone ? source.width : 2400, format: "webp", quality: 85 }),
	]);
	return { src: small.src, full: full.src, width: Number(small.attributes.width), height: Number(small.attributes.height) };
}

const views: { id: Shot["id"]; file: string; icon: string; phone: boolean }[] = [
	{ id: "list", file: "list", icon: "tabler:list", phone: false },
	{ id: "grid", file: "grid", icon: "tabler:layout-grid", phone: false },
	{ id: "preview", file: "preview", icon: "tabler:photo", phone: false },
	{ id: "connect", file: "qr", icon: "tabler:qrcode", phone: false },
	{ id: "mobile", file: "mobile", icon: "tabler:device-mobile", phone: true },
];

const shots: Shot[] = await Promise.all(
	views.map(async view => ({
		id: view.id,
		icon: view.icon,
		phone: view.phone,
		light: await optimize(screenshot(view.file, "light"), view.phone),
		dark: await optimize(screenshot(view.file, "dark"), view.phone),
	})),
);

// What the CLI prints when it starts (sample address).
const terminalOutput = `Storage path: C:\\Users\\you\\Documents\\Locale Drive
Server listening on: http://192.168.1.20:24680
▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
█ ▄▄▄▄▄ ██▀▀▄▄ ██▄█ ▄▄▄▄▄ █
█ █   █ █▀███ ▀▀▀ █ █   █ █
█ █▄▄▄█ █▄▄█▀▀█▄█▀█ █▄▄▄█ █
█▄▄▄▄▄▄▄█▄█ ▀▄█▄█▄█▄▄▄▄▄▄▄█
█ ▄▀██▄▄▄▀ █▄▀ █  ▀██  ▀▀██
█▀▄▀▄▄ ▄  ▀▄█▀▄█ ▀█▄▄▀ █▄ █
█ █▄▄▀▀▄▄▀ █▄▄█ ▀▄▄▄████▀▄█
█ █ ▄ ▀▄█▀▄▀ ▄▄▀▄▀▄█▄▀▄▀▄ █
█▄█▄███▄█▀  ▄ ▄▀▀ ▄▄▄ █ ███
█ ▄▄▄▄▄ █ ▄█▄ ▄██ █▄█ ▄█▀ █
█ █   █ ██▀▄▀▀▄█▄▄▄  ▄ ▄▀▀█
█ █▄▄▄█ █▀█ █ ▄▄▀▀▄▀▀▀█▄█ █
█▄▄▄▄▄▄▄█▄█████▄▄▄█▄██▄██▄█`;

const npmCommands = ["npm install -g locale-drive", "locale-drive /path/to/folder", "npx locale-drive /path/to/folder"];

const sectionTitle = "text-3xl sm:text-4xl font-bold tracking-tight text-balance";
const sectionSubtitle = "max-w-2xl mx-auto opacity-60 text-balance";
const card = "rounded-box border border-subtle bg-base-100";
---

<div id="top">
	<Header language={language} />

	<main class="flex flex-col gap-24 sm:gap-32 px-4 sm:px-6 lg:px-10 pt-14 sm:pt-20 pb-16">
		<!-- Hero -->
		<section class="max-w-6xl w-full mx-auto flex flex-col items-center gap-10 sm:gap-14">
			<div class="flex flex-col items-center gap-6 text-center">
				<a href={GITHUB_URL} target="_blank" rel="noreferrer" class="badge badge-lg gap-2 border border-subtle bg-base-100 py-4 px-4 hover:bg-base-200 transition-colors">
					<span class="size-2 rounded-full bg-success"></span>
					<span class="text-sm">{t.hero.badge}</span>
					<Icon icon="tabler:arrow-up-right" className="text-sm opacity-60" />
				</a>

				<h1 class="max-w-4xl text-4xl sm:text-6xl font-extrabold tracking-tight text-balance leading-[1.05]">
					{t.hero.title.split(" ").slice(0, -2).join(" ")}{" "}
					<span class="text-primary">{t.hero.title.split(" ").slice(-2).join(" ")}</span>
				</h1>

				<p class="max-w-2xl text-lg opacity-70 text-balance">{t.hero.subtitle}</p>

				<div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
					<a href="#download" class="btn btn-primary btn-lg w-full sm:w-auto">
						<Icon icon="tabler:brand-windows" className="text-xl" />
						{t.hero.download}
					</a>
					<a href="#npm" class="btn btn-subtle btn-lg w-full sm:w-auto">
						<Icon icon="tabler:brand-npm" className="text-2xl" />
						{t.hero.npm}
					</a>
				</div>

				<p class="text-sm opacity-50">
					<span data-release="version-label" hidden={!release}>{t.hero.version} <span data-release="version">{release?.version}</span> · </span>{t.hero.note}
				</p>
			</div>

			<!-- App preview: desktop screenshot with the phone version on top. -->
			<div class="relative w-full">
				<div class={`${card} p-2 sm:p-3 shadow-2xl shadow-primary/10`}>
					<div class="flex items-center gap-1.5 px-2 pb-2 sm:pb-3">
						<span class="size-2.5 rounded-full bg-base-content/15"></span>
						<span class="size-2.5 rounded-full bg-base-content/15"></span>
						<span class="size-2.5 rounded-full bg-base-content/15"></span>
						<span class="ml-3 hidden sm:flex items-center gap-1.5 px-3 py-1 rounded-field bg-base-200 text-xs opacity-70 font-mono">
							<Icon icon="tabler:lock-open" className="text-xs" />
							http://192.168.1.20:24680
						</span>
					</div>
					<div class="overflow-hidden rounded-field border border-subtle">
						<Image src={screenshot("list", "light")} alt={t.screenshots.captions.list} width={1600} format="webp" loading="eager" class="only-light w-full h-auto" />
						<Image src={screenshot("list", "dark")} alt={t.screenshots.captions.list} width={1600} format="webp" loading="eager" class="only-dark w-full h-auto" />
					</div>
				</div>

				<div class="hidden md:block absolute -right-4 lg:-right-8 -bottom-10 w-44 lg:w-56 p-1.5 rounded-[1.75rem] border border-subtle bg-base-100 shadow-2xl">
					<div class="overflow-hidden rounded-[1.4rem] border border-subtle">
						<Image src={screenshot("mobile", "light")} alt={t.screenshots.captions.mobile} width={480} format="webp" class="only-light w-full h-auto" />
						<Image src={screenshot("mobile", "dark")} alt={t.screenshots.captions.mobile} width={480} format="webp" class="only-dark w-full h-auto" />
					</div>
				</div>
			</div>

			<ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm opacity-70">
				{
					t.hero.pills.map(pill => (
						<li class="flex items-center gap-1.5">
							<Icon icon="tabler:circle-check" className="text-base text-success" />
							{pill}
						</li>
					))
				}
			</ul>
		</section>

		<!-- What it is: one host, many browsers. -->
		<section class="max-w-6xl w-full mx-auto flex flex-col gap-10">
			<div class="flex flex-col gap-3 text-center">
				<h2 class={sectionTitle}>{t.concept.title}</h2>
				<p class={sectionSubtitle}>{t.concept.subtitle}</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr_auto_1fr] items-center gap-3 md:gap-4">
				{
					[
						{ icon: "tabler:device-laptop", ...t.concept.host },
						{ icon: "tabler:wifi", ...t.concept.network },
						{ icon: "tabler:devices", ...t.concept.devices },
					].map((item, i) => (
						<>
							{i > 0 && (
								<div class="flex justify-center text-primary/60">
									<Icon icon="tabler:arrows-left-right" className="text-2xl hidden md:block" />
									<Icon icon="tabler:arrows-up-down" className="text-2xl md:hidden" />
								</div>
							)}
							<div class={`${card} h-full flex flex-col items-center text-center gap-3 p-6`}>
								<span class="flex justify-center items-center size-14 rounded-box bg-primary/10 text-primary">
									<Icon icon={item.icon} className="text-3xl" />
								</span>
								<h3 class="text-lg font-semibold">{item.title}</h3>
								<p class="text-sm opacity-60">{item.body}</p>
							</div>
						</>
					))
				}
			</div>
		</section>

		<!-- How it works -->
		<section id="how-it-works" class="max-w-6xl w-full mx-auto flex flex-col gap-10">
			<div class="flex flex-col gap-3 text-center">
				<h2 class={sectionTitle}>{t.how.title}</h2>
				<p class={sectionSubtitle}>{t.how.subtitle}</p>
			</div>

			<ol class="grid grid-cols-1 md:grid-cols-3 gap-4">
				{
					t.how.steps.map((step, i) => (
						<li class={`${card} flex flex-col gap-3 p-6`}>
							<div class="flex items-center gap-3">
								<span class="flex justify-center items-center size-9 rounded-full bg-primary text-primary-content font-bold">{i + 1}</span>
								<Icon icon={["tabler:player-play", "tabler:qrcode", "tabler:folder-share"][i]} className="text-2xl text-primary/70" />
							</div>
							<h3 class="text-lg font-semibold">{step.title}</h3>
							<p class="text-sm opacity-60">{step.body}</p>
						</li>
					))
				}
			</ol>
		</section>

		<!-- Screenshots -->
		<section id="screenshots" class="max-w-6xl w-full mx-auto flex flex-col gap-10">
			<div class="flex flex-col gap-3 text-center">
				<h2 class={sectionTitle}>{t.screenshots.title}</h2>
				<p class={sectionSubtitle}>{t.screenshots.subtitle}</p>
			</div>

			<Screenshots client:visible shots={shots} t={t.screenshots} />
		</section>

		<!-- Features -->
		<section id="features" class="max-w-6xl w-full mx-auto flex flex-col gap-10">
			<div class="flex flex-col gap-3 text-center">
				<h2 class={sectionTitle}>{t.features.title}</h2>
				<p class={sectionSubtitle}>{t.features.subtitle}</p>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
				{
					t.features.items.map(item => (
						<div class={`${card} flex flex-col gap-2 p-5 hover:bg-base-200 transition-colors`}>
							<Icon icon={item.icon} className="text-2xl text-primary" />
							<h3 class="font-semibold">{item.title}</h3>
							<p class="text-sm opacity-60">{item.body}</p>
						</div>
					))
				}
			</div>
		</section>

		<!-- Download -->
		<section id="download" class="max-w-6xl w-full mx-auto flex flex-col gap-10">
			<div class="flex flex-col gap-3 text-center">
				<h2 class={sectionTitle}>{t.download.title}</h2>
				<p class={sectionSubtitle}>{t.download.subtitle}</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
				<div class={`${card} relative flex flex-col gap-4 p-6 border-primary/50 ring-1 ring-primary/30`}>
					<span class="badge badge-primary badge-sm absolute top-4 right-4">{t.download.recommended}</span>
					<span class="flex justify-center items-center size-12 rounded-box bg-primary/10 text-primary">
						<Icon icon="tabler:brand-windows" className="text-2xl" />
					</span>
					<div class="flex flex-col gap-1 grow">
						<h3 class="text-lg font-semibold">{t.download.installer.title}</h3>
						<p class="text-sm opacity-60">{t.download.installer.body}</p>
					</div>
					<a href={installer?.url ?? RELEASES_URL} data-release="installer" class="btn btn-primary w-full">
						<Icon icon="tabler:download" className="text-xl" />
						{t.download.installer.button}
					</a>
					<p class="text-xs opacity-50 font-mono truncate" data-release="installer-name" title={installer?.name ?? ""}>{installer?.name ?? "…-setup.exe"}</p>
				</div>

				<div class={`${card} flex flex-col gap-4 p-6`}>
					<span class="flex justify-center items-center size-12 rounded-box bg-base-200 text-base-content/80">
						<Icon icon="tabler:file-zip" className="text-2xl" />
					</span>
					<div class="flex flex-col gap-1 grow">
						<h3 class="text-lg font-semibold">{t.download.portable.title}</h3>
						<p class="text-sm opacity-60">{t.download.portable.body}</p>
					</div>
					<a href={portable?.url ?? RELEASES_URL} data-release="portable" class="btn btn-subtle w-full">
						<Icon icon="tabler:download" className="text-xl" />
						{t.download.portable.button}
					</a>
					<p class="text-xs opacity-50 font-mono truncate" data-release="portable-name" title={portable?.name ?? ""}>{portable?.name ?? "…-portable.zip"}</p>
				</div>

				<div class={`${card} flex flex-col gap-4 p-6`}>
					<span class="flex justify-center items-center size-12 rounded-box bg-base-200 text-error">
						<Icon icon="tabler:brand-npm" className="text-3xl" />
					</span>
					<div class="flex flex-col gap-1 grow">
						<h3 class="text-lg font-semibold">{t.download.npm.title}</h3>
						<p class="text-sm opacity-60">{t.download.npm.body}</p>
					</div>
					<a href="#npm" class="btn btn-subtle w-full">
						<Icon icon="tabler:terminal-2" className="text-xl" />
						{t.download.npm.button}
					</a>
					<p class="text-xs opacity-50 font-mono truncate">npm install -g locale-drive</p>
				</div>
			</div>

			<div class={`${card} flex flex-col sm:flex-row gap-4 p-6`}>
				<Icon icon="tabler:info-circle" className="text-2xl text-info" />
				<div class="flex flex-col gap-3 grow">
					<h3 class="font-semibold">{t.download.desktopNotes.title}</h3>
					<ul class="flex flex-col gap-2 text-sm opacity-70">
						{
							t.download.desktopNotes.items.map(item => (
								<li class="flex gap-2">
									<Icon icon="tabler:point-filled" className="text-xs mt-1.5 text-primary" />
									<span>{item}</span>
								</li>
							))
						}
					</ul>
					<a href={RELEASES_URL} target="_blank" rel="noreferrer" class="link link-primary text-sm w-fit flex items-center gap-1">
						{t.download.allReleases}
						<Icon icon="tabler:arrow-up-right" className="text-sm" />
					</a>
				</div>
			</div>
		</section>

		<!-- npm -->
		<section id="npm" class="max-w-6xl w-full mx-auto flex flex-col gap-10">
			<div class="flex flex-col gap-3 text-center">
				<h2 class={sectionTitle}>{t.npmGuide.title}</h2>
				<p class={sectionSubtitle}>{t.npmGuide.subtitle(NODE_VERSION)}</p>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 [&>*]:min-w-0">
				<div class={`${card} flex flex-col gap-5 p-6`}>
					{
						t.npmGuide.steps.map((step, i) => (
							<div class="flex flex-col gap-2">
								<div class="flex items-center gap-3">
									<span class="flex justify-center items-center size-7 rounded-full bg-primary text-primary-content text-sm font-bold">{i + 1}</span>
									<h3 class="font-semibold">{step.title}</h3>
								</div>
								<p class="text-sm opacity-60">{step.body}</p>
								<Command command={npmCommands[i]} language={language} />
							</div>
						))
					}
					<p class="flex gap-2 text-sm opacity-60">
						<Icon icon="tabler:folder" className="text-base mt-0.5" />
						{t.npmGuide.defaultFolder}
					</p>
				</div>

				<!-- What the terminal shows. -->
				<div class="flex flex-col rounded-box border border-subtle bg-neutral text-neutral-content overflow-hidden">
					<div class="flex items-center gap-1.5 px-4 py-3 border-b border-white/10">
						<span class="size-2.5 rounded-full bg-white/20"></span>
						<span class="size-2.5 rounded-full bg-white/20"></span>
						<span class="size-2.5 rounded-full bg-white/20"></span>
						<span class="ml-3 flex items-center gap-1.5 text-xs opacity-60">
							<Icon icon="tabler:terminal-2" className="text-sm" />
							{t.npmGuide.terminalTitle}
						</span>
					</div>
					<pre class="grow p-5 text-xs sm:text-sm leading-relaxed overflow-x-auto font-mono"><span class="text-success">$</span> npx locale-drive
{terminalOutput.split("\n").slice(0, 2).join("\n")}
<span class="block leading-none mt-1" aria-hidden="true">{terminalOutput.split("\n").slice(2).join("\n")}</span></pre>
				</div>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] gap-4">
				<div class={`${card} flex flex-col gap-3 p-4 sm:p-6`}>
					<h3 class="flex items-center gap-2 font-semibold">
						<Icon icon="tabler:adjustments-horizontal" className="text-xl text-primary" />
						{t.npmGuide.optionsTitle}
					</h3>
					<div class="overflow-x-auto">
						<table class="table">
							<thead>
								<tr>
									<th>{t.npmGuide.columns.option}</th>
									<th>{t.npmGuide.columns.alias}</th>
									<th>{t.npmGuide.columns.default}</th>
									<th>{t.npmGuide.columns.description}</th>
								</tr>
							</thead>
							<tbody>
								{
									t.npmGuide.options.map(row => (
										<tr>
											<td><code class="font-mono text-primary whitespace-nowrap">{row.option}</code></td>
											<td><code class="font-mono opacity-70">{row.alias}</code></td>
											<td><code class="font-mono opacity-70">{row.default}</code></td>
											<td class="opacity-70 min-w-48">{row.description}</td>
										</tr>
									))
								}
							</tbody>
						</table>
					</div>
				</div>

				<div class="flex flex-col gap-4">
					<div class={`${card} flex flex-col gap-3 p-4 sm:p-6`}>
						<h3 class="flex items-center gap-2 font-semibold">
							<Icon icon="tabler:code" className="text-xl text-primary" />
							{t.npmGuide.examplesTitle}
						</h3>
						{t.npmGuide.examples.map(example => <Command command={example.command} comment={example.comment} language={language} />)}
					</div>
					<div class={`${card} flex flex-col gap-2 p-4 sm:p-6`}>
						<h3 class="flex items-center gap-2 font-semibold">
							<Icon icon="tabler:plug-connected" className="text-xl text-primary" />
							{t.npmGuide.portsTitle}
						</h3>
						<p class="text-sm opacity-70">{t.npmGuide.ports}</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Security note -->
		<section class="max-w-6xl w-full mx-auto">
			<div class="flex flex-col sm:flex-row gap-4 p-6 rounded-box border border-warning/40 bg-warning/10">
				<Icon icon="tabler:shield-lock" className="text-3xl text-warning" />
				<div class="flex flex-col gap-1">
					<h2 class="text-lg font-semibold">{t.security.title}</h2>
					<p class="text-sm opacity-80">{t.security.body}</p>
				</div>
			</div>
		</section>

		<!-- FAQ -->
		<section id="faq" class="max-w-3xl w-full mx-auto flex flex-col gap-10">
			<div class="flex flex-col gap-3 text-center">
				<h2 class={sectionTitle}>{t.faq.title}</h2>
			</div>

			<div class="flex flex-col gap-2">
				{
					t.faq.items.map((item, i) => (
						<details class={`collapse collapse-arrow ${card}`} open={i === 0}>
							<summary class="collapse-title font-semibold">{item.q}</summary>
							<div class="collapse-content text-sm opacity-70">
								<p>{item.a}</p>
							</div>
						</details>
					))
				}
			</div>
		</section>
	</main>

	<footer class="px-4 sm:px-6 lg:px-10 pb-[calc(1.5rem+env(safe-area-inset-bottom,0px))]">
		<div class={`max-w-6xl mx-auto grid grid-cols-1 sm:grid-cols-[2fr_1fr_1fr] gap-8 p-6 sm:p-8 ${card}`}>
			<div class="flex flex-col gap-3">
				<a href="#top" class="flex items-center gap-2.5 w-fit">
					<img src={withBase("/favicon.svg")} alt="" width="32" height="32" class="size-8" />
					<span class="font-bold text-lg">Locale Drive</span>
				</a>
				<p class="text-sm opacity-60 max-w-xs">{t.footer.tagline}</p>
				<p class="text-xs opacity-50">
					© {new Date().getFullYear()} · <a href={LICENSE_URL} target="_blank" rel="noreferrer" class="link">{t.footer.license}</a> · {t.footer.madeBy}{" "}
					<a href="https://github.com/lullaby6" target="_blank" rel="noreferrer" class="link">lullaby6</a>
				</p>
			</div>

			<div class="flex flex-col gap-2 text-sm">
				<h3 class="font-semibold mb-1">{t.footer.product}</h3>
				<a href="#download" class="opacity-60 hover:opacity-100 w-fit">{t.nav.download}</a>
				<a href="#npm" class="opacity-60 hover:opacity-100 w-fit">npm</a>
				<a href="#features" class="opacity-60 hover:opacity-100 w-fit">{t.nav.features}</a>
				<a href="#faq" class="opacity-60 hover:opacity-100 w-fit">{t.nav.faq}</a>
			</div>

			<div class="flex flex-col gap-2 text-sm">
				<h3 class="font-semibold mb-1">{t.footer.project}</h3>
				<a href={GITHUB_URL} target="_blank" rel="noreferrer" class="opacity-60 hover:opacity-100 w-fit">GitHub</a>
				<a href={NPM_URL} target="_blank" rel="noreferrer" class="opacity-60 hover:opacity-100 w-fit">npm</a>
				<a href={DESKTOP_REPO_URL} target="_blank" rel="noreferrer" class="opacity-60 hover:opacity-100 w-fit">{t.footer.desktopRepo}</a>
				<a href={ISSUES_URL} target="_blank" rel="noreferrer" class="opacity-60 hover:opacity-100 w-fit">{t.footer.issues}</a>
			</div>
		</div>
	</footer>
</div>

<script>
	// Points the download buttons at the files of the latest release, so a new release shows up
	// without rebuilding the site. Kept for an hour per tab to stay far from GitHub's API limits.
	import { fetchLatestRelease } from "@/release";
	import type { LatestRelease } from "@/release";

	const CACHE_KEY = "locale-drive:latest-release";
	const CACHE_TIME = 60 * 60 * 1000;

	async function getRelease(): Promise<LatestRelease | null> {
		try {
			const cached = JSON.parse(sessionStorage.getItem(CACHE_KEY) ?? "null");
			if (cached && Date.now() - cached.time < CACHE_TIME) return cached.release;
		} catch {
			// No session storage: just ask GitHub.
		}

		const release = await fetchLatestRelease();
		if (release) {
			try {
				sessionStorage.setItem(CACHE_KEY, JSON.stringify({ time: Date.now(), release }));
			} catch {
				// Not cached; it works anyway.
			}
		}
		return release;
	}

	const set = (key: string, apply: (element: HTMLElement) => void) =>
		document.querySelectorAll<HTMLElement>(`[data-release="${key}"]`).forEach(apply);

	getRelease().then(release => {
		if (!release) return;

		set("version", element => (element.textContent = release.version));
		set("version-label", element => (element.hidden = false));

		for (const kind of ["installer", "portable"] as const) {
			const asset = release[kind];
			if (!asset) continue;

			set(kind, element => element.setAttribute("href", asset.url));
			set(`${kind}-name`, element => {
				element.textContent = asset.name;
				element.title = asset.name;
			});
		}
	});
</script>
